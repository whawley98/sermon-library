# .env.local
# ─────────────────────────────────────────────────────────────
# Sermon Library — Environment Variables
#
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to GitHub — it's in .gitignore.
#
# For GitHub Pages deployment, add these as GitHub Secrets
# (Settings → Secrets → Actions) — the deploy workflow
# will inject them automatically at build time.
# ─────────────────────────────────────────────────────────────

# Anthropic API key — powers runtime AI features (Ask the Collection)
# Get one at: https://console.anthropic.com
REACT_APP_ANTHROPIC_API_KEY=sk-ant-api03-your-key-here
